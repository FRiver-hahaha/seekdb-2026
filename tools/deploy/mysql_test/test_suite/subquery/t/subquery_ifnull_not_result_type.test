#owner: oceanbase
#owner group: shenzhen

# Issue #1477: IFNULL with a boolean scalar subquery and a double-negated LIKE
# fails with ERROR 4016 (HY000): Internal error.
#
# Removing a pair of NOT operators replaces the NOT expression with the boolean
# form of its operand. NOT always yields an INT32 result, while operands such
# as LIKE may yield a wider type. Without keeping the original result type the
# parent IFNULL re-derives a wider type for its operands and asks for a second
# implicit cast on the scalar subquery, which already carries one implicit
# cast. That duplicate cast is rejected with OB_ERR_UNEXPECTED (-4016).

# minimal reproducer
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE 'x')));

# control: a single negation is not eliminated
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE 'x'));

# control: a boolean literal instead of a scalar subquery
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE 'x')));

# the NOT pair may also be the first argument of IFNULL
SELECT IFNULL(!(!(1 LIKE '1')), (SELECT FALSE)) AS value;

# three-valued logic: a NULL operand keeps the NULL result
SELECT IFNULL((SELECT NULL), !(!(NULL LIKE 'x'))) AS value;

# a non-boolean operand still needs the boolean conversion
SELECT IFNULL((SELECT NULL), !(!(2))) AS value;

# a longer chain of NOT operators is handled the same way
SELECT IFNULL((SELECT NULL), !(!(!(!(1 LIKE '1'))))) AS value;

--disable_warnings
drop table if exists t_issue_1477;
--enable_warnings
create table t_issue_1477(c1 int, c2 varchar(20));
insert into t_issue_1477 values (1, 'hello'), (2, 'world');

# a non-NULL false subquery evaluates to FALSE and filters out every row
SELECT c1 FROM t_issue_1477 WHERE IFNULL((SELECT FALSE), !(!(c2 LIKE '%ell%')));
SELECT c1 FROM t_issue_1477 WHERE IFNULL((SELECT c1 > 10 FROM t_issue_1477 LIMIT 1), !(!(c2 LIKE 'w%')));

# a NULL subquery evaluates the fallback double-negated LIKE expression
SELECT c1 FROM t_issue_1477 WHERE IFNULL((SELECT NULL), !(!(c2 LIKE '%ell%')));
SELECT c1 FROM t_issue_1477 WHERE IFNULL((SELECT c1 FROM t_issue_1477 WHERE c1 > 10), !(!(c2 LIKE 'w%')));

drop table t_issue_1477;
