#owner: competition-team
# owner group: SQL
# tags: rewrite
#description: Regression test for issue #1477, IFNULL with a boolean scalar
# subquery as the first argument and a double negated LIKE predicate used to
# abort the statement with ERROR 4016 during type deduction.

# The predicate below requires the implicit cast above the negated LIKE
# expression to be deduced more than once. Casting an expression that already
# carries an implicit cast is a correct conversion and must not raise an
# internal error, so the statement returns an empty result set.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));

# Control cases keep their previous behavior: one negation instead of two, and a
# literal instead of the scalar subquery.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));
