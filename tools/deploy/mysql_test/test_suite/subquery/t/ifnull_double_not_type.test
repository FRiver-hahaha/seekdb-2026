# Regression for issue 1477: double NOT must retain its result type.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE "1")));
SELECT IFNULL((SELECT NULL), !(!(NULL LIKE "x"))) AS value;
SELECT IFNULL((SELECT NULL), !(!(!(!(1 LIKE "1"))))) AS value;
SELECT IFNULL(!(!(1 LIKE "1")), (SELECT FALSE)) AS value;
CREATE TABLE t_ifnull_not_type (id INT PRIMARY KEY, n INT, s VARCHAR(10));
INSERT INTO t_ifnull_not_type VALUES (1, 0, 'x'), (2, 1, 'y'), (3, NULL, 'x'), (4, NULL, NULL);
SELECT id FROM t_ifnull_not_type WHERE IFNULL((SELECT n FROM dual), !(!(s LIKE 'x'))) ORDER BY id;
DROP TABLE t_ifnull_not_type;
