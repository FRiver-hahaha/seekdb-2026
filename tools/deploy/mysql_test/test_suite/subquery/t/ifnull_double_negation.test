# tags: optimizer
# Regression for issue #1477: eliminating NOT NOT must preserve its result type.

SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE 'x')));

# Controls: a single NOT and a literal first argument.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE 'x'));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE 'x')));

# TRUE, NULL, and longer even NOT chains.
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE '1')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(NULL LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE 'x')))));

# Non-boolean operands still need truth-value conversion.
SELECT IFNULL((SELECT NULL), !(!(2))) AS positive_value,
       IFNULL((SELECT NULL), !(!(-2))) AS negative_value,
       IFNULL((SELECT NULL), !(!(0))) AS zero_value;

# Nonconstant and correlated operands retain SQL NULL semantics.
CREATE TABLE ifnull_double_negation_t (id INT PRIMARY KEY, s VARCHAR(8), flag TINYINT);
INSERT INTO ifnull_double_negation_t VALUES
  (1, 'x', 0), (2, 'y', 1), (3, NULL, NULL), (4, 'x', NULL), (5, 'y', NULL);
SELECT id FROM ifnull_double_negation_t
WHERE IFNULL((SELECT FALSE), !(!(s LIKE 'x'))) ORDER BY id;
SELECT id FROM ifnull_double_negation_t
WHERE IFNULL((SELECT NULL), !(!(s LIKE 'x'))) ORDER BY id;
SELECT id, IFNULL((SELECT NULL), !(!(s LIKE 'x'))) AS matched
FROM ifnull_double_negation_t ORDER BY id;
SELECT id FROM ifnull_double_negation_t
WHERE IFNULL((SELECT flag), !(!(s LIKE 'x'))) ORDER BY id;
DROP TABLE ifnull_double_negation_t;

# A boolean predicate must remain recognizable by range extraction.
CREATE TABLE not_range_t (id INT PRIMARY KEY, s VARCHAR(8), KEY idx_s(s));
INSERT INTO not_range_t VALUES (1, 'x'), (2, 'y'), (3, NULL);
--replace_regex / +$//
EXPLAIN BASIC SELECT /*+ INDEX(not_range_t idx_s) */ id FROM not_range_t
WHERE !(!(s LIKE 'x'));
--replace_regex / +$//
EXPLAIN BASIC SELECT /*+ INDEX(not_range_t idx_s) */ id FROM not_range_t
WHERE (!(!(s LIKE 'x')) OR !(!(s LIKE 'y'))) AND id > 0;
SELECT id FROM not_range_t
WHERE (!(!(s LIKE 'x')) OR !(!(s LIKE 'y'))) AND id > 0 ORDER BY id;
DROP TABLE not_range_t;
