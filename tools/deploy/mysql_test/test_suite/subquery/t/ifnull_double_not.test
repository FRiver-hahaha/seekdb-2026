# Regression for oceanbase/seekdb#1477: removing paired NOT operators must
# preserve the result type used by IFNULL's existing implicit operand casts.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('x' LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('y' LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(NULL LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE "x")))));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(-2)));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(0)));

CREATE TABLE t_ifnull_double_not (id INT PRIMARY KEY, val VARCHAR(8), KEY idx_val(val));
INSERT INTO t_ifnull_double_not VALUES (1, 'x'), (2, 'y'), (3, NULL);
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(val LIKE 'x'))) ORDER BY id;
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT FALSE), !(!(val LIKE 'x'))) ORDER BY id;
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(!(!(val LIKE 'x'))))) ORDER BY id;
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT NULL), IFNULL((SELECT NULL), !(!(val LIKE 'x')))) ORDER BY id;
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(val IS NULL))) ORDER BY id;
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(val LIKE 'x'))) IS NULL ORDER BY id;
SELECT id FROM t_ifnull_double_not WHERE !(!(val LIKE 'x%')) ORDER BY id;
SELECT id FROM t_ifnull_double_not WHERE !(!(val LIKE 'x%')) AND id > 0 ORDER BY id;
SELECT id FROM t_ifnull_double_not WHERE !(!(val LIKE 'x%')) OR val LIKE 'y%' ORDER BY id;
EXPLAIN BASIC SELECT /*+ INDEX(t_ifnull_double_not idx_val) */ id FROM t_ifnull_double_not
WHERE !(!(val LIKE 'x%'));
EXPLAIN BASIC SELECT /*+ INDEX(t_ifnull_double_not idx_val) */ id FROM t_ifnull_double_not
WHERE !(!(val LIKE 'x%')) AND id > 0;
EXPLAIN BASIC SELECT /*+ INDEX(t_ifnull_double_not idx_val) */ id FROM t_ifnull_double_not
WHERE !(!(val LIKE 'x%')) OR val LIKE 'y%';
DROP TABLE t_ifnull_double_not;
