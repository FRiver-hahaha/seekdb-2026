# Regression for issue #1477: eliminating an even NOT chain must preserve its type.
--disable_query_log
--echo # Original reproducer: no rows and no internal error
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));

--echo # Controls: one NOT and no scalar subquery
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));

--echo # A true scalar subquery keeps the row
SELECT 1 AS value FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE 'x')));

--echo # NULL subqueries use the fallback, preserving false, true and NULL
SELECT IFNULL((SELECT NULL), !(!(1 LIKE 'x'))) AS value;
SELECT IFNULL((SELECT NULL), !(!(1 LIKE '1'))) AS value;
SELECT IFNULL((SELECT NULL), !(!(NULL LIKE 'x'))) AS value;
SELECT 1 AS value FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE '1')));

--echo # Longer even and odd NOT chains
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE 'x')))));
SELECT IFNULL((SELECT NULL), !(!(!(!(1 LIKE '1'))))) AS value;
SELECT IFNULL((SELECT NULL), !(!(!(1 LIKE 'x')))) AS value;

--echo # Numeric operands still convert to boolean, including zero and NULL
SELECT !(!(-2)) AS nonzero_value, !(!(0)) AS zero_value, !(!(NULL)) AS null_value;

--echo # Row-dependent LIKE and correlated scalar subqueries
CREATE TABLE ifnull_double_not (id INT PRIMARY KEY, b INT, s VARCHAR(10));
INSERT INTO ifnull_double_not VALUES
  (1, 0, 'x'), (2, 1, 'other'), (3, NULL, 'x'), (4, NULL, 'other'), (5, NULL, NULL);
SELECT id, IFNULL((SELECT b), !(!(s LIKE 'x%'))) AS value
  FROM ifnull_double_not ORDER BY id;
SELECT id FROM ifnull_double_not
  WHERE IFNULL((SELECT b), !(!(s LIKE 'x%'))) ORDER BY id;
DROP TABLE ifnull_double_not;
--enable_query_log
