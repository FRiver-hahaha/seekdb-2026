# Regression for issue #1477: NOT rewrites must preserve value-context types.
--disable_info
--disable_metadata

# Original reproducer and both controls from the issue.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));

# TRUE, NULL, longer NOT chains, and non-boolean truth conversion.
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('abc' LIKE 'ab%')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(1 LIKE "x"))));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE "x")))));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(2)));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(0)));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(NULL)));

--disable_warnings
DROP TABLE IF EXISTS issue1477_not_types;
--enable_warnings
CREATE TABLE issue1477_not_types (
  id INT PRIMARY KEY,
  txt VARCHAR(16),
  flag TINYINT,
  KEY idx_txt(txt)
);
INSERT INTO issue1477_not_types VALUES
  (1, 'abc', 0), (2, 'abd', 1), (3, NULL, NULL), (4, 'z', NULL);

# Nonconstant and correlated operands keep their truth/NULL semantics.
SELECT id FROM issue1477_not_types
WHERE IFNULL((SELECT flag), !(!(txt LIKE 'ab%'))) ORDER BY id;
SELECT id FROM issue1477_not_types
WHERE IFNULL((SELECT NULL), !(!(txt LIKE 'ab%'))) ORDER BY id;
SELECT id FROM issue1477_not_types
WHERE IFNULL((SELECT flag), !(!(!(txt LIKE 'ab%')))) ORDER BY id;
SELECT id FROM issue1477_not_types
WHERE COALESCE((SELECT flag), !(!(txt LIKE 'ab%'))) ORDER BY id;
SELECT id FROM issue1477_not_types
WHERE IFNULL((SELECT flag), (!(!(txt LIKE 'ab%')) AND id < 4)) ORDER BY id;
SELECT id FROM issue1477_not_types
WHERE IFNULL((SELECT flag), (!(!(txt LIKE 'ab%')) OR id = 4)) ORDER BY id;

# Predicate contexts remain unwrapped for range extraction.
EXPLAIN BASIC SELECT id FROM issue1477_not_types FORCE INDEX(idx_txt)
WHERE !(!(txt LIKE 'ab%'));
EXPLAIN BASIC SELECT id FROM issue1477_not_types FORCE INDEX(idx_txt)
WHERE !(!(txt LIKE 'ab%')) AND id > 0;
SELECT id FROM issue1477_not_types WHERE !(!(txt LIKE 'ab%')) ORDER BY id;
DROP TABLE issue1477_not_types;
