      access([t_ifnull_boolean_subquery.id]), partitions(p0)
      is_index_back=false, is_global_index=false,
      range_key([t_ifnull_boolean_subquery.value], [t_ifnull_boolean_subquery.id]), range(...),
      range_cond([(T_OP_LIKE, t_ifnull_boolean_subquery.value, 'x%', '\\')])
