# https://github.com/oceanbase/seekdb/issues/1477
# IFNULL with a boolean scalar subquery as the first argument and a
# double-negated LIKE as the second argument failed with
# ERROR 4016 (OB_ERR_UNEXPECTED) during type re-deduction in query
# rewrite: the scalar subquery ref already carried an implicit cast
# while the merged result type of IFNULL had become wider.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE "x")));
1
1
SELECT IFNULL((SELECT NULL), !(!(1 LIKE "x"))) IS NULL FROM dual;
IFNULL((SELECT NULL), !(!(1 LIKE "x"))) IS NULL
0
