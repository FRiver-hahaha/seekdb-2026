CREATE TABLE not_rewrite_rows (id INT PRIMARY KEY, txt VARCHAR(20), KEY idx_txt(txt));
INSERT INTO not_rewrite_rows VALUES (1, 'alpha'), (2, 'beta'), (3, NULL);
SELECT id FROM not_rewrite_rows t
WHERE IFNULL((SELECT CASE WHEN t.id = 2 THEN FALSE ELSE NULL END), !(!(t.txt LIKE 'a%')))
ORDER BY id;
