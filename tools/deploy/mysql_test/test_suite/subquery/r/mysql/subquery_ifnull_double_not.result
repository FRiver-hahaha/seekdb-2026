DROP TABLE IF EXISTS t_ifnull_double_not;
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE 'x')));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE 'x'));
1
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE 'x')));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE 'x')))));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE 'x')));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE 'x')));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE '1')));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE FROM dual WHERE FALSE), !(!(1 LIKE '1')));
1
1
CREATE TABLE t_ifnull_double_not (id INT PRIMARY KEY, n INT, s VARCHAR(10));
INSERT INTO t_ifnull_double_not VALUES
(1, 0, 'x'), (2, 1, 'x'), (3, 2, 'y'), (4, NULL, NULL), (5, -3, 'x');
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT FALSE), !(!(s LIKE 'x'))) ORDER BY id;
id
SELECT id FROM t_ifnull_double_not
WHERE IFNULL((SELECT TRUE), !(!(s LIKE 'x'))) ORDER BY id;
id
