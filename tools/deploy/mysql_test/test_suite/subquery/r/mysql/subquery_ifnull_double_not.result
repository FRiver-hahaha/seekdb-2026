SELECT id, IFNULL((SELECT NULL), !(!(s LIKE 'x'))) AS fallback
FROM t_ifnull_double_not ORDER BY id;
id	fallback
1	1
2	1
3	0
4	NULL
5	1
PREPARE stmt FROM 'SELECT id FROM t_ifnull_double_not WHERE IFNULL((SELECT ?), !(!(s LIKE ?))) ORDER BY id';
SET @first = NULL, @pattern = 'x';
EXECUTE stmt USING @first, @pattern;
id
1
2
5
SET @first = FALSE;
EXECUTE stmt USING @first, @pattern;
id
DEALLOCATE PREPARE stmt;
DROP TABLE t_ifnull_double_not;
