SELECT IFNULL((SELECT NULL), !(!(2))) AS positive_value,
IFNULL((SELECT NULL), !(!(-2))) AS negative_value,
IFNULL((SELECT NULL), !(!(0))) AS zero_value;
positive_value	negative_value	zero_value
1	1	0
CREATE TABLE ifnull_double_negation_t (id INT PRIMARY KEY, s VARCHAR(8), flag TINYINT);
