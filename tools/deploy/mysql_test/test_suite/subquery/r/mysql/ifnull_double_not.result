DROP TABLE IF EXISTS ifnull_double_not;
CREATE TABLE ifnull_double_not (id INT PRIMARY KEY, s VARCHAR(10), n INT);
INSERT INTO ifnull_double_not VALUES (1, 'x', 2), (2, 'y', 0), (3, NULL, NULL);
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT FALSE), !(!(s LIKE 'x'))) ORDER BY id;
id
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(s LIKE 'x'))) ORDER BY id;
