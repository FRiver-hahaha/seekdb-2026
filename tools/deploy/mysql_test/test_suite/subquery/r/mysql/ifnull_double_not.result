1
SELECT IFNULL((SELECT 2), !(!(1 LIKE "x"))) AS value;
value
2
CREATE TABLE ifnull_double_not (id INT PRIMARY KEY, v INT);
INSERT INTO ifnull_double_not VALUES (1, -2), (2, 0), (3, 1), (4, 3), (5, NULL);
SELECT id FROM ifnull_double_not t
WHERE IFNULL((SELECT t.v > 0), !(!(t.v LIKE "1"))) ORDER BY id;
id
3
4
SELECT id, IFNULL((SELECT t.v), !(!(t.v LIKE "1"))) AS value
FROM ifnull_double_not t ORDER BY id;
id	value
1	-2
2	0
3	1
4	3
5	NULL
DROP TABLE ifnull_double_not;
