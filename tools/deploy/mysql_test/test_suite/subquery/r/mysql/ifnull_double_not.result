PREPARE double_not_stmt FROM
'SELECT 1 FROM dual WHERE IFNULL((SELECT ?), !(!(? LIKE ?)))';
SET @b = 0, @s = 'x', @p = 'x';
EXECUTE double_not_stmt USING @b, @s, @p;
1
SET @b = 1;
EXECUTE double_not_stmt USING @b, @s, @p;
1
1
SET @b = NULL;
EXECUTE double_not_stmt USING @b, @s, @p;
1
1
SET @s = 'y';
EXECUTE double_not_stmt USING @b, @s, @p;
1
DEALLOCATE PREPARE double_not_stmt;
DROP TABLE t_double_not;
CREATE TABLE t_double_not_range (id INT PRIMARY KEY, s VARCHAR(8), KEY idx_s(s));
EXPLAIN BASIC SELECT id FROM t_double_not_range FORCE INDEX(idx_s)
WHERE !(!(s LIKE 'x%'));
Query Plan
===============================================
|ID|OPERATOR        |NAME                     |
-----------------------------------------------
|0 |TABLE RANGE SCAN|t_double_not_range(idx_s)|
===============================================
Outputs & filters:
-------------------------------------
  0 - output([t_double_not_range.id]), filter(nil), rowset=N
      access([t_double_not_range.id]), partitions(p0)
      is_index_back=false, is_global_index=false,
      range_key([t_double_not_range.s], [t_double_not_range.id]), range(x,MIN ; x￿￿￿￿￿￿￿￿￿￿ ,MAX),
      range_cond([(T_OP_LIKE, t_double_not_range.s, 'x%', '\\')])
EXPLAIN BASIC SELECT id FROM t_double_not_range FORCE INDEX(idx_s)
WHERE !(!(s LIKE 'x%')) AND id > 0;
