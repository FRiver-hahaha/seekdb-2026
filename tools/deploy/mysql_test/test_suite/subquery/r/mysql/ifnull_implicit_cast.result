SELECT IFNULL(1,2), IFNULL(NULL,3), IFNULL('a','b'), 1 LIKE '1', NOT (1 LIKE '2');
IFNULL(1,2)	IFNULL(NULL,3)	IFNULL('a','b')	1 LIKE '1'	NOT (1 LIKE '2')
