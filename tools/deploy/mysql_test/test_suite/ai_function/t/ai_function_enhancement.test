### AI 函数增强用例: ai_prompt / ai_embed / ai_complete / ollama / ai_rerank / 跨行批量
### 需要 Mock AI Service 监听 127.0.0.1:8000

connection default;

--disable_warnings
drop table if exists enh_text_t;
drop table if exists enh_embed_t;
--enable_warnings

--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_ep_complete');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_ep_embed');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_ep_rerank');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_ep_ollama_c');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_ep_ollama_e');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_ep_switch');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_m_complete');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_m_embed');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_m_rerank');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_m_ollama_c');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_m_ollama_e');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_m_switch');

### 子题1: AI_PROMPT 类型与模板增强
# json 对象和数组作为参数
select ai_prompt('{0}+{1}={2}', '1');
select ai_prompt('{0}-{0}-{0}', 'x');
select ai_prompt('value: {0} {1}', json_object('a','1'), json_array(1,2));
# 转义的大括号是字面量
select ai_prompt('a{{0}}b', 'x');

create table enh_text_t (t text, l longtext);
insert into enh_text_t values('hello {0}', 'long {0}');
select ai_prompt(t, 'w') from enh_text_t;
select ai_prompt(l, 'w') from enh_text_t;
drop table enh_text_t;

### 模型与 endpoint
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_m_complete','{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_m_embed','{"type":"dense_embedding","model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_m_rerank','{"type":"rerank","model_name":"mock-rerank"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_m_ollama_c','{"type":"completion","model_name":"mock-ollama-c"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_m_ollama_e','{"type":"dense_embedding","model_name":"mock-ollama-e"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_m_switch','{"type":"completion","model_name":"mock-switch"}');

call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_ep_complete','{"ai_model_name":"enh_m_complete","url":"http://127.0.0.1:8000/v1/chat/completions","access_key":"sk-test","request_model_name":"mock","provider":"openai"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_ep_embed','{"ai_model_name":"enh_m_embed","url":"http://127.0.0.1:8000/v1/embeddings","access_key":"sk-test","request_model_name":"mock","provider":"openai"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_ep_rerank','{"ai_model_name":"enh_m_rerank","url":"http://127.0.0.1:8000/v1/rerank","access_key":"sk-test","request_model_name":"mock","provider":"siliconflow"}');
# ollama 端点不需要 access key
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_ep_ollama_c','{"ai_model_name":"enh_m_ollama_c","url":"http://127.0.0.1:8000/api/generate","request_model_name":"mock","provider":"ollama"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_ep_ollama_e','{"ai_model_name":"enh_m_ollama_e","url":"http://127.0.0.1:8000/api/embed","request_model_name":"mock","provider":"ollama"}');

### 子题3: AI_COMPLETE 请求与响应
select length(ai_complete('enh_m_complete','hello')) > 0;
select length(ai_complete('enh_m_complete','hello','{"temperature":0.1,"max_tokens":16}')) > 0;
# config 为 null 时不解析
select length(ai_complete('enh_m_complete','hello',null)) > 0;
# json prompt 参数
select length(ai_complete('enh_m_complete', ai_prompt('say {0}','hi'))) > 0;
# 非法占位符下标
--error 1210
select ai_complete('enh_m_complete', ai_prompt('value {3}','x'));

### 子题2: AI_EMBED 默认维度与显式维度
select json_type(ai_embed('enh_m_embed','hello'));
select json_length(ai_embed('enh_m_embed','hello')) = json_length(ai_embed('enh_m_embed','world'));
select json_length(ai_embed('enh_m_embed','hello',3));
select ai_embed('enh_m_embed',null) is null;
--error 1210
select ai_embed('enh_m_embed','hello',0);
--error 1210
select ai_embed('enh_m_embed','hello',1.5);

### 子题4: Ollama Provider
select length(ai_complete('enh_m_ollama_c','hi')) > 0;
select json_type(ai_embed('enh_m_ollama_e','hi'));
select json_length(ai_embed('enh_m_ollama_e','hi',3));

# provider 修改: openai -> ollama
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_ep_switch','{"ai_model_name":"enh_m_switch","url":"http://127.0.0.1:8000/v1/chat/completions","access_key":"sk-test","request_model_name":"mock","provider":"openai"}');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enh_ep_switch','{"provider":"ollama","url":"http://127.0.0.1:8000/api/generate"}');
select PROVIDER, URL from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS where ENDPOINT_NAME = 'enh_ep_switch';
select length(ai_complete('enh_m_switch','hi')) > 0;

### 子题5: AI_RERANK 结果正确性
select json_length(ai_rerank('enh_m_rerank','query', json_array('doc a','doc b','doc c')));
select json_length(ai_rerank('enh_m_rerank','query', json_array('d01','d02','d03','d04','d05','d06','d07','d08','d09','d10','d11','d12','d13','d14','d15','d16','d17','d18','d19','d20','d21','d22','d23','d24','d25')));
select json_length(ai_rerank('enh_m_rerank','query', json_array(json_object('id',1,'text','alpha'),json_object('id',2,'text','beta'),json_object('id',3,'text','gamma')), 'text'));

### 子题6: AI_EMBED 跨行批量
create table enh_embed_t (id int, a varchar(20));
insert into enh_embed_t values (1,'x'),(2,null),(3,'y'),(4,'z'),(5,'w');
select id, ai_embed('enh_m_embed',a) is null from enh_embed_t order by id;
select count(distinct ai_embed('enh_m_embed',a)) from enh_embed_t;
select id, json_length(ai_embed('enh_m_embed',a)) = json_length(ai_embed('enh_m_embed','hello')) from enh_embed_t where a is not null order by id;
drop table enh_embed_t;

