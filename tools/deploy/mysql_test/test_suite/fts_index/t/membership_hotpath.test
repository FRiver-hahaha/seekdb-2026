# ID-only natural-language scans must preserve membership and score consumers.
--disable_warnings
DROP DATABASE IF EXISTS fts_membership;
CREATE DATABASE fts_membership;
USE fts_membership;
--enable_warnings
SET NAMES utf8mb4;
SET ob_query_timeout = 10000000000;

CREATE TABLE docs (id INT PRIMARY KEY, body TEXT,
  FULLTEXT INDEX f_beng(body) WITH PARSER beng) CHARSET=utf8mb4;
BEGIN;
--disable_query_log
let $i=1;
while ($i <= 1537)
{
  eval INSERT INTO docs VALUES ($i, CASE MOD($i, 4)
    WHEN 0 THEN 'database performance alpha alpha'
    WHEN 1 THEN 'database audit beta'
    WHEN 2 THEN 'alpha beta café résumé'
    ELSE 'unrelated document' END);
  inc $i;
}
--enable_query_log
INSERT INTO docs VALUES (1600, NULL), (1601, ''), (1602, 'the with and');
COMMIT;

# Cross output batches and compare ID checksums, duplicates and empty inputs.
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('database alpha beta');
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('database database alpha beta beta');
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('alpha missingword') AND id BETWEEN 100 AND 1100;
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('missingword');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('the with');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST(NULL);
SELECT COUNT(*), SUM(id) FROM
  (SELECT id FROM docs WHERE MATCH(body) AGAINST('database alpha beta') ORDER BY id LIMIT 31 OFFSET 17) t;
SELECT COUNT(*) FROM
  (SELECT id FROM docs WHERE MATCH(body) AGAINST('database alpha beta') LIMIT 0) t;

# Numeric, Boolean, ordering and aggregate consumers must retain BM25 scores.
SELECT id, ROUND(MATCH(body) AGAINST('database alpha beta'), 10) AS score
FROM docs WHERE MATCH(body) AGAINST('database alpha beta') ORDER BY score DESC, id LIMIT 6;
SELECT id, MATCH(body) AGAINST('database alpha beta') != 0 AS found
FROM docs WHERE MATCH(body) AGAINST('database alpha beta') ORDER BY id LIMIT 6;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('database alpha beta') > 0;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('database alpha beta') > 0.01;
SELECT ROUND(SUM(MATCH(body) AGAINST('database alpha beta')), 8) AS total_score
FROM docs WHERE MATCH(body) AGAINST('database alpha beta');
SELECT id, ROUND(SUM(MATCH(body) AGAINST('database alpha beta')), 10) AS score
FROM docs WHERE MATCH(body) AGAINST('database alpha beta')
GROUP BY id HAVING score > 0.01 ORDER BY id LIMIT 6;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('+database -audit' IN BOOLEAN MODE);
SELECT COUNT(*), SUM(id) FROM docs WHERE NOT MATCH(body) AGAINST('database');
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('database') OR id=1600;

# Prepared plans must handle missing, dense and long query token sets.
PREPARE member_query FROM 'SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST(?)';
SET @q='missingword';
EXECUTE member_query USING @q;
SET @q='database alpha beta';
EXECUTE member_query USING @q;
SET @q='alpha';
--disable_query_log
let $j=1;
while ($j <= 300)
{
  eval SET @q=CONCAT(@q, ' missingtoken', $j);
  inc $j;
}
--enable_query_log
EXECUTE member_query USING @q;
SET @q='beta';
EXECUTE member_query USING @q;
DEALLOCATE PREPARE member_query;

# A parameterized threshold continues to use the same score semantics.
PREPARE threshold_query FROM 'SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST(?) > ?';
SET @q='database alpha beta';
SET @threshold=0.0;
EXECUTE threshold_query USING @q, @threshold;
SET @threshold=0.01;
EXECUTE threshold_query USING @q, @threshold;
SET @threshold=1.0;
EXECUTE threshold_query USING @q, @threshold;
DEALLOCATE PREPARE threshold_query;

# Subqueries and transactional updates retain the original visibility rules.
SELECT COUNT(*), SUM(id) FROM docs d WHERE MATCH(body) AGAINST('database alpha beta')
AND EXISTS (SELECT 1 FROM docs other WHERE other.id=d.id AND other.id < 100);
BEGIN;
UPDATE docs SET body='missingword' WHERE id BETWEEN 1 AND 40;
DELETE FROM docs WHERE id BETWEEN 41 AND 80;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('database alpha beta');
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('missingword');
ROLLBACK;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('database alpha beta');
DROP DATABASE fts_membership;
