DROP DATABASE IF EXISTS fts_collation;
CREATE DATABASE fts_collation;
USE fts_collation;
SET NAMES utf8mb4;
CREATE TABLE words_ci (id INT PRIMARY KEY, word VARCHAR(64) COLLATE utf8mb4_general_ci);
INSERT INTO words_ci VALUES
(1, 'resume'), (2, 'résumé'), (3, 'RESUME'),
(4, 'cafe'), (5, 'café'), (6, 'cafe '),
(7, ''), (8, ' '), (9, '  '), (10, NULL),
(11, '中文'), (12, '中文'), (13, '中文 '), (14, '汉字'),
(15, 'ＡＢＣ'), (16, 'abc'), (17, '😀'), (18, '𠀀'),
(19, CONVERT(UNHEX('610062') USING utf8mb4)),
(20, CONVERT(UNHEX('61006200') USING utf8mb4));
CREATE TABLE words_bin (id INT PRIMARY KEY, word VARCHAR(64) COLLATE utf8mb4_bin);
INSERT INTO words_bin SELECT * FROM words_ci;
CREATE TABLE words_unicode (id INT PRIMARY KEY, word VARCHAR(64) COLLATE utf8mb4_unicode_ci);
INSERT INTO words_unicode SELECT * FROM words_ci;
CREATE TABLE binary_ids (id INT PRIMARY KEY, word VARBINARY(64));
INSERT INTO binary_ids VALUES
(1, UNHEX('')), (2, UNHEX('00')), (3, UNHEX('0000')),
(4, UNHEX('0001')), (5, UNHEX('01')), (6, UNHEX('0100')),
(7, UNHEX('0120')), (8, UNHEX('20')), (9, UNHEX('2020')),
(10, UNHEX('80')), (11, UNHEX('ff')), (12, UNHEX('ffff')),
(13, UNHEX('0001')), (14, NULL);
SELECT GROUP_CONCAT(id ORDER BY word, id) AS ordered_ids FROM words_ci;
ordered_ids
