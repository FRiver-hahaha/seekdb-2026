load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "uuid_node_cases",
    srcs = ["test_uuid_node.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:uuid_node_unit_test_impl",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_test(
    name = "test_uuid_node",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    linkopts = [
        "-Wl,--wrap=socket",
        "-Wl,--wrap=ioctl",
        "-Wl,--wrap=close",
        "-Wl,--wrap=RAND_bytes",
    ],
    deps = [
        ":uuid_node_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
